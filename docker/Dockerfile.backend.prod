# =============================================================================
# Orbito Backend Production Dockerfile (Turborepo Pruned + NestJS 11)
# =============================================================================

# Stage 1: Prune monorepo for @orbito/backend
FROM node:22-slim AS pruner

WORKDIR /app
RUN npm install -g turbo@2.11.10
COPY . .
RUN turbo prune @orbito/backend --docker

# =============================================================================
# Stage 2: Install dependencies & Build
# =============================================================================
FROM node:22-slim AS installer

WORKDIR /app

# Install build dependencies for native compilation and OpenSSL for Prisma
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    python3 \
    make \
    g++ \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# First copy pruned json manifests to leverage Docker cache for npm ci
COPY --from=pruner /app/out/json/ .
RUN npm ci

# Copy full pruned source tree
COPY --from=pruner /app/out/full/ .

# Generate Prisma Client & compile
ENV DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder?schema=public"
RUN npm run prisma:generate --workspace=@orbito/backend
RUN npm run build --workspace=@orbito/types
RUN npm run build --workspace=@orbito/backend

# =============================================================================
# Stage 3: Minimal Production Runtime
# =============================================================================
FROM node:22-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    curl \
    netcat-openbsd \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Dedicated non-root user
RUN addgroup --system --gid 1001 orbito && \
    adduser --system --uid 1001 --ingroup orbito orbito

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

COPY --chown=orbito:orbito --from=installer /app/node_modules ./node_modules
COPY --chown=orbito:orbito --from=installer /app/package.json ./package.json
COPY --chown=orbito:orbito --from=installer /app/packages ./packages
COPY --chown=orbito:orbito --from=installer /app/backend/package.json ./backend/package.json
COPY --chown=orbito:orbito --from=installer /app/backend/prisma ./backend/prisma
COPY --chown=orbito:orbito --from=installer /app/backend/dist ./backend/dist
COPY --chown=orbito:orbito --from=installer /app/backend/node_modules ./backend/node_modules

# Ensure uploads directory is owned by non-root user
RUN mkdir -p /app/backend/uploads && chown -R orbito:orbito /app/backend/uploads

USER orbito
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -f http://localhost:3000/api/health || exit 1

CMD ["node", "backend/dist/main.js"]
