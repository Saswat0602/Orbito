# =============================================================================
# Orbito Frontend Production Dockerfile (Turborepo Pruned + Next.js 16 Standalone)
# =============================================================================

# Stage 1: Prune monorepo for @orbito/frontend
FROM node:22-slim AS pruner

WORKDIR /app
RUN npm install -g turbo@2.11.10
COPY . .
RUN turbo prune @orbito/frontend --docker

# =============================================================================
# Stage 2: Install dependencies & Build Standalone
# =============================================================================
FROM node:22-slim AS installer

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Leverage Docker cache for npm ci
COPY --from=pruner /app/out/json/ .
RUN npm ci

# Copy full pruned source tree
COPY --from=pruner /app/out/full/ .

ARG NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api"
ARG NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_SOCKET_URL=$NEXT_PUBLIC_SOCKET_URL
ENV NODE_ENV=production

RUN npm run build --workspace=@orbito/types
RUN npm run build --workspace=@orbito/frontend

# =============================================================================
# Stage 3: Minimal Production Runtime
# =============================================================================
FROM node:22-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Dedicated non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nextjs

ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

COPY --chown=nextjs:nodejs --from=installer /app/frontend/.next/standalone ./
COPY --chown=nextjs:nodejs --from=installer /app/frontend/.next/static ./frontend/.next/static
COPY --chown=nextjs:nodejs --from=installer /app/frontend/public ./frontend/public

USER nextjs
EXPOSE 3001

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:3001/api/health || exit 1

CMD ["node", "frontend/server.js"]
