# ==========================================
# Orbito Enterprise Configuration Template
# Copy this file to .env and adjust variables
# ==========================================

# PostgreSQL Configuration (Docker Compose)
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=orbito
POSTGRES_PORT=5433

# Database Connection URL
DATABASE_URL="postgresql://root:root@localhost:5433/orbito"

# Application Environment
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Authentication & Security
# Generate secure keys via: openssl rand -base64 32
JWT_SECRET="orbito-jwt-super-secret-development-key-change-in-prod"
JWT_REFRESH_SECRET="orbito-jwt-refresh-secret-development-key-change-in-prod"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AES-256-GCM Encryption Key for integrations & BYOK LLM credentials
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Single Sign-On (SSO) / OpenID Connect (OIDC)
# Supports Google, Okta, Keycloak, Auth0, Azure AD, etc.
SSO_ENABLED=false
SSO_PROVIDER_NAME="Google"
SSO_ISSUER_URL="https://accounts.google.com"
SSO_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
SSO_CLIENT_SECRET="your-google-client-secret"
SSO_REDIRECT_URI="http://localhost:3000/api/auth/oidc/callback"

# Redis Configuration (BullMQ Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@orbito.io
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@orbito.io
EMAIL_DOMAIN="orbito.io"

# Client Application URL & CORS
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN="http://localhost:3001"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001"

# Frontend Public API & Socket Gateway
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# File Upload Settings
UPLOAD_DEST="./uploads"
MAX_FILE_SIZE=10485760
MAX_EDITOR_IMAGE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
EDITOR_IMAGE_UPLOAD_FOLDER=editor-images
MAX_AVATAR_SIZE=52428800

# Queue Worker Concurrency
MAX_CONCURRENT_JOBS=5
JOB_RETRY_ATTEMPTS=3
BULL_BOARD_EMAIL="admin@orbito.io"
BULL_BOARD_PASSWORD="admin_secret_password"

# SSRF Security & Integrations
JIRA_ALLOWED_HOSTS=*.atlassian.net
AI_ALLOWED_HOSTS=api.openai.com,*.anthropic.com,openrouter.ai
AI_ALLOW_PRIVATE_ENDPOINTS=false

# AWS S3 Cloud Storage (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=orbito-assets
