{
  "name": "@orbito/backend",
  "version": "1.0.0",
  "description": "Orbito Backend - NestJS Clean Architecture API Server",
  "private": true,
  "scripts": {
    "build": "npm run prisma:generate && nest build",
    "dev": "npm run prisma:generate && nest start --watch",
    "start": "nest start",
    "start:dev": "npm run dev",
    "start:debug": "npm run prisma:generate && nest start --debug --watch",
    "start:prod": "npm run prisma:generate && node dist/main",
    "clean": "rm -rf dist",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset",
    "prisma": "prisma",
    "seed": "ts-node -r tsconfig-paths/register src/seeder/seeder.command.ts seed",
    "seed:admin": "ts-node -r tsconfig-paths/register src/seeder/seeder.command.ts admin",
    "seed:clear": "ts-node -r tsconfig-paths/register src/seeder/seeder.command.ts clear",
    "seed:reset": "ts-node -r tsconfig-paths/register src/seeder/seeder.command.ts reset",
    "seed:demo": "ts-node -r tsconfig-paths/register src/seeder/demo-seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@bull-board/api": "^9.13.1",
    "@bull-board/express": "^9.13.1",
    "@nestjs/bull": "^12.0.2",
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/platform-socket.io": "^12.5.0",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.5.0",
    "@orbito/types": "*",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "better-queue": "^3.8.12",
    "bullmq": "^6.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "html-entities": "^2.6.0",
    "imapflow": "^2.11.0",
    "ioredis": "^6.0.0",
    "mailparser": "^3.14.3",
    "marked": "^18.2.0",
    "mime": "^4.0.7",
    "mime-types": "^3.0.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.5.0",
    "openid-client": "^6.9.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.18.2",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/marked": "^6.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^26",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!.*)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register src/seeder/seeder.command.ts seed"
  }
}
