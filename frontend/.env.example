# =============================================================================
# Orbito Frontend Configuration (.env.example)
# =============================================================================

# Public REST API URL for RTK Query & Browser requests
# In development: http://localhost:3000/api
# In production: https://api.yourdomain.com/api (or /api if using reverse proxy)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Public WebSocket Gateway URL for Socket.IO real-time collaboration
# In development: http://localhost:3000
# In production: https://api.yourdomain.com (or https://yourdomain.com if using reverse proxy)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Frontend Web Server Port (Default: 3001)
PORT=3001

# Node Environment
NODE_ENV=production

