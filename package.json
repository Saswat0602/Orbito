{
  "name": "@orbito/platform",
  "version": "1.0.0",
  "description": "Orbito - Production Enterprise Project Management with Conversational AI Task Execution",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "turbo run dev",
    "dev:frontend": "turbo run dev --filter=@orbito/frontend",
    "dev:backend": "turbo run dev --filter=@orbito/backend",
    "dev:types": "turbo run dev --filter=@orbito/types",
    "build": "turbo run build",
    "build:frontend": "turbo run build --filter=@orbito/frontend",
    "build:backend": "turbo run build --filter=@orbito/backend",
    "build:types": "turbo run build --filter=@orbito/types",
    "lint": "turbo run lint",
    "lint:frontend": "turbo run lint --filter=@orbito/frontend",
    "lint:backend": "turbo run lint --filter=@orbito/backend",
    "test": "turbo run test",
    "test:backend": "turbo run test --filter=@orbito/backend",
    "clean": "turbo run clean && rm -rf node_modules dist out .next .turbo",
    "start:frontend": "npm run start --workspace=@orbito/frontend",
    "start:backend": "npm run start:prod --workspace=@orbito/backend",
    "db:migrate": "dotenv -- npm run prisma:migrate:dev --workspace=@orbito/backend",
    "db:migrate:deploy": "dotenv -- npm run prisma:migrate:deploy --workspace=@orbito/backend",
    "db:reset": "dotenv -- npm run prisma:reset --workspace=@orbito/backend",
    "db:seed": "dotenv -- npm run seed --workspace=@orbito/backend",
    "db:seed:admin": "dotenv -- npm run seed:admin --workspace=@orbito/backend",
    "db:seed:clear": "dotenv -- npm run seed:clear --workspace=@orbito/backend",
    "db:seed:reset": "dotenv -- npm run seed:reset --workspace=@orbito/backend",
    "db:seed:demo": "dotenv -- npm run seed:demo --workspace=@orbito/backend",
    "db:generate": "dotenv -- npm run prisma:generate --workspace=@orbito/backend",
    "db:studio": "dotenv -- npm run prisma:studio --workspace=@orbito/backend",
    "prisma": "dotenv -- npm run prisma --workspace=@orbito/backend",
    "preflight": "node scripts/production-readiness.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv-cli": "^7.4.4",
    "turbo": "^2.11.10"
  }
}
