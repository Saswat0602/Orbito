{
  "name": "@orbito/platform",
  "version": "1.0.0",
  "description": "Orbito - Production Enterprise Project Management with Conversational AI Task Execution",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=@orbito/frontend",
    "dev:backend": "npm run start:dev --workspace=@orbito/backend",
    "build": "npm run build:workspaces",
    "build:workspaces": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=@orbito/frontend",
    "build:backend": "npm run build --workspace=@orbito/backend",
    "turbo:build": "turbo run build",
    "turbo:dev": "turbo run dev",
    "turbo:lint": "turbo run lint",
    "turbo:test": "turbo run test",
    "lint": "npm run lint:workspaces",
    "lint:workspaces": "npm run lint --workspaces --if-present",
    "lint:frontend": "npm run lint --workspace=@orbito/frontend",
    "lint:backend": "npm run lint --workspace=@orbito/backend",
    "test": "npm run test:workspaces",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:backend": "npm run test --workspace=@orbito/backend",
    "start:frontend": "npm run start --workspace=@orbito/frontend",
    "start:backend": "npm run start:prod --workspace=@orbito/backend",
    "db:migrate": "dotenv -- npm run prisma:migrate:dev --workspace=@orbito/backend",
    "db:migrate:deploy": "dotenv -- npm run prisma:migrate:deploy --workspace=@orbito/backend",
    "db:reset": "dotenv -- npm run prisma:reset --workspace=@orbito/backend",
    "db:seed": "dotenv -- npm run seed --workspace=@orbito/backend",
    "db:seed:admin": "dotenv -- npm run seed:admin --workspace=@orbito/backend",
    "db:seed:clear": "dotenv -- npm run seed:clear --workspace=@orbito/backend",
    "db:seed:reset": "dotenv -- npm run seed:reset --workspace=@orbito/backend",
    "db:seed:demo": "dotenv -- npm run seed:demo --workspace=@orbito/backend",
    "db:generate": "dotenv -- npm run prisma:generate --workspace=@orbito/backend",
    "db:studio": "dotenv -- npm run prisma:studio --workspace=@orbito/backend",
    "prisma": "dotenv -- npm run prisma --workspace=@orbito/backend",
    "clean": "rm -rf node_modules dist out .next"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv-cli": "^7.4.4",
    "turbo": "^2.11.10"
  }
}
