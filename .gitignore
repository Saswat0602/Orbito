# ==============================================================================
# Orbito Monorepo - Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Turborepo Cache
.turbo/
**/.turbo/

# Production & Build Artifacts
dist/
**/dist/
build/
**/build/
.next/
**/.next/
out/
**/out/

# TypeScript Build Info & Declaration Maps
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts

# Test Coverage & Reports
coverage/
**/coverage/
.nyc_output/
*.lcov

# Environment Variables & Secrets (Keep .env.example)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.crt

# Runtime Data, Uploads & Local Storage
uploads/
**/uploads/
app_uploads/
postgres_data/
redis_data/
*.sqlite
*.sqlite3
*.db
*.db-journal

# Logs & Debugging
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs & Developer Tooling
.idea/
.project
.classpath
.c9/
*.launch
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Temporary & Cache Directories
.cache/
**/.cache/
.temp/
tmp/
temp/

# Planning Documentation
plan/

